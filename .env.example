# Required — set these in Vercel: Project → Settings → Environment Variables.
# NEVER commit real values. NEVER put these in frontend JS.

# Password you type to unlock the editor (server-side only).
ADMIN_PASSWORD=choose-a-long-random-password-here

# Random secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=paste-64-hex-chars-here

# Read/write token for Vercel Blob storage (portfolio content persistence).
# Dashboard → Storage → Create Database → Blob → connect to project (auto-injects),
# or create manually under Storage → your store → Settings.
# BLOB_READ_WRITE_TOKEN=paste-vercel-blob-token-here
