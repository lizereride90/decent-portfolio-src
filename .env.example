# Required — set these in Netlify: Site settings → Environment variables.
# NEVER commit real values. NEVER put these in frontend JS.

# Password you type to unlock the editor (server-side only).
ADMIN_PASSWORD=choose-a-long-random-password-here

# Random secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=paste-64-hex-chars-here

# Optional — only needed if the function reports a Blobs "not configured" error.
# Most runtimes provision storage automatically; if yours doesn't, add these:
# - BLOBS_SITE_ID: Netlify dashboard → your site → Site settings → General → Site ID
# - BLOBS_TOKEN: Netlify avatar → User settings → Applications → Personal access tokens → New access token
# BLOBS_SITE_ID=paste-site-id-here
# BLOBS_TOKEN=paste-personal-access-token-here

# Vercel only — read/write token for Vercel Blob storage.
# Dashboard → Storage → Create Database → Blob → connect to project (auto-injects),
# or create manually under Storage → your store → Settings.
# BLOB_READ_WRITE_TOKEN=paste-vercel-blob-token-here
